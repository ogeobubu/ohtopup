{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".agents/rules/*.md"
  ],
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "cat*": "allow",
          "head*": "allow",
          "tail*": "allow",
          "rg*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "npm test": "allow",
          "node --test*": "allow",
          "npm run lint": "allow",
          "cd client && npm run lint": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "rg*": "allow"
        }
      }
    }
  }
}
